<odoo>
    <record id="module_category_chebu_mpesa" model="ir.module.category">
        <field name="name">Chebu M-Pesa</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_chebu_mpesa_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_chebu_mpesa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_chebu_mpesa_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_chebu_mpesa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root'))]"/>
    </record>
</odoo>
