<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="my_arena_note_view_list" model="ir.ui.view">
        <field name="name">my.arena.note.view.list</field>
        <field name="model">my.arena.note</field>
        <field name="arch" type="xml">
            <list string="My Notes" decoration-muted="is_archived">
                <field name="is_pinned" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="priority"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="is_archived"/>
                <field name="write_date"/>
            </list>
        </field>
    </record>

    <record id="my_arena_note_view_form" model="ir.ui.view">
        <field name="name">my.arena.note.view.form</field>
        <field name="model">my.arena.note</field>
        <field name="arch" type="xml">
            <form string="My Note">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="What is this note about?"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="priority"/>
                            <field name="tag_ids" widget="many2many_tags" context="{'default_user_id': uid}"/>
                        </group>
                        <group>
                            <field name="is_pinned"/>
                            <field name="is_archived"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note">
                            <field name="body" placeholder="Write anything you want to remember..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="my_arena_note_view_kanban" model="ir.ui.view">
        <field name="name">my.arena.note.view.kanban</field>
        <field name="model">my.arena.note</field>
        <field name="arch" type="xml">
            <kanban default_group_by="priority" class="o_kanban_small_column">
                <field name="name"/>
                <field name="body"/>
                <field name="tag_ids"/>
                <field name="color"/>
                <field name="priority"/>
                <field name="is_pinned"/>
                <field name="is_archived"/>
                <templates>
                    <t t-name="card">
                        <field name="color" widget="kanban_color_picker"/>
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <i t-if="record.is_pinned.raw_value" class="fa fa-thumb-tack text-warning" title="Pinned"/>
                                <strong class="o_kanban_record_title fs-5"><field name="name"/></strong>
                            </div>
                            <field name="is_pinned" widget="boolean_toggle"/>
                        </div>
                        <div class="text-muted o_text_overflow_3">
                            <field name="body"/>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <field name="tag_ids" widget="many2many_tags"/>
                            <span t-if="record.priority.raw_value == '2'" class="badge text-bg-danger">Urgent</span>
                            <span t-elif="record.priority.raw_value == '1'" class="badge text-bg-warning">Important</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="my_arena_note_view_search" model="ir.ui.view">
        <field name="name">my.arena.note.view.search</field>
        <field name="model">my.arena.note</field>
        <field name="arch" type="xml">
            <search string="Search My Notes">
                <field name="name"/>
                <field name="body"/>
                <field name="tag_ids"/>
                <filter name="pinned" string="Pinned" domain="[('is_pinned', '=', True)]"/>
                <filter name="active_notes" string="Active" domain="[('is_archived', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('is_archived', '=', True)]"/>
                <separator/>
                <filter name="important" string="Important" domain="[('priority', 'in', ['1', '2'])]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="my_arena_note_action" model="ir.actions.act_window">
        <field name="name">My Notes</field>
        <field name="res_model">my.arena.note</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="my_arena_note_view_search"/>
        <field name="context">{'default_user_id': uid, 'search_default_active_notes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first note
            </p>
            <p>
                Keep private thoughts, tasks, reminders, and ideas in your own arena.
            </p>
        </field>
    </record>

    <record id="my_arena_note_tag_view_list" model="ir.ui.view">
        <field name="name">my.arena.note.tag.view.list</field>
        <field name="model">my.arena.note.tag</field>
        <field name="arch" type="xml">
            <list string="My Tags">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="my_arena_note_tag_view_form" model="ir.ui.view">
        <field name="name">my.arena.note.tag.view.form</field>
        <field name="model">my.arena.note.tag</field>
        <field name="arch" type="xml">
            <form string="My Tag">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Ideas, Work, Personal"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="my_arena_note_tag_action" model="ir.actions.act_window">
        <field name="name">My Tags</field>
        <field name="res_model">my.arena.note.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_user_id': uid}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a tag</p>
            <p>Organize your private notes around the things that matter to you.</p>
        </field>
    </record>
</odoo>
