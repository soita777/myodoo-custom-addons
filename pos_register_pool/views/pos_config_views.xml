<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_register_pool" model="ir.ui.view">
        <field name="name">pos.config.form.register.pool</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='module_pos_hr']/ancestor::setting" position="after">
                <setting string="Exclusive Register"
                    help="The first salesperson to open this register claims it until its POS session is closed.">
                    <field name="register_pool_enabled" readonly="has_active_session"/>
                    <div class="content-group mt16" invisible="not register_pool_enabled">
                        <div class="row">
                            <div class="col-lg-4 o_light_label">
                                <label for="register_occupant_name" string="Current occupant"/>
                            </div>
                            <div class="col-lg-8">
                                <field name="register_occupant_name" readonly="1"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="view_pos_config_tree_register_pool" model="ir.ui.view">
        <field name="name">pos.config.list.register.pool</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="register_is_occupied" string="Occupied"/>
                <field name="register_occupant_initial" string="Initial"/>
                <field name="register_occupant_name" string="Salesperson"/>
            </xpath>
        </field>
    </record>
</odoo>
