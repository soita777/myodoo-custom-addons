<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Register List View -->
    <record id="view_pos_register_list" model="ir.ui.view">
        <field name="name">pos.register.list</field>
        <field name="model">pos.register</field>
        <field name="arch" type="xml">
            <list string="POS Registers">
                <field name="name"/>
                <field name="code"/>
                <field name="branch"/>
                <field name="state"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Register Form View -->
    <record id="view_pos_register_form" model="ir.ui.view">
        <field name="name">pos.register.form</field>
        <field name="model">pos.register</field>
        <field name="arch" type="xml">
            <form string="POS Register">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group>
                            <field name="code"/>
                            <field name="branch"/>
                        </group>

                        <group>
                            <field name="state"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <group>
                        <field name="description"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>


    <!-- Register Action -->
    <record id="action_pos_register" model="ir.actions.act_window">
        <field name="name">POS Registers</field>
        <field name="res_model">pos.register</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Create and manage your physical POS registers.
            </p>
        </field>
    </record>


    <!-- POS Menu -->
    <menuitem
        id="menu_pos_registers"
        name="Registers"
        parent="point_of_sale.menu_point_root"
        action="action_pos_register"
        sequence="25"
        groups="point_of_sale.group_pos_user"
    />

</odoo>
