<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="company_device_employee_rule" model="ir.rule">
        <field name="name">Company devices: assigned to me</field>
        <field name="model_id" ref="model_company_device"/>
        <field name="domain_force">[('assigned_user', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="company_device_manager_rule" model="ir.rule">
        <field name="name">Company devices: manager access</field>
        <field name="model_id" ref="model_company_device"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="company_device_assignment_manager_rule" model="ir.rule">
        <field name="name">Company device assignments: manager access</field>
        <field name="model_id" ref="model_company_device_assignment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
