<odoo>
    <record id="view_movement_ledger_list" model="ir.ui.view">
        <field name="name">chebu.inventory.movement.ledger.list</field>
        <field name="model">chebu.inventory.movement.ledger</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="quantity_signed &gt; 0" decoration-warning="quantity_signed &lt; 0">
                <field name="name"/>
                <field name="effective_datetime"/>
                <field name="product_id"/>
                <field name="quantity_signed" sum="Net Quantity"/>
                <field name="movement_type"/>
                <field name="source_location_id"/>
                <field name="destination_location_id"/>
                <field name="lot_id"/>
                <field name="company_id"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="view_movement_ledger_search" model="ir.ui.view">
        <field name="name">chebu.inventory.movement.ledger.search</field>
        <field name="model">chebu.inventory.movement.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="movement_type"/>
                <field name="stock_move_line_id"/>
                <field name="effective_datetime"/>
                <filter name="incoming" string="Incoming" domain="[('quantity_signed', '>', 0)]"/>
                <filter name="outgoing" string="Outgoing" domain="[('quantity_signed', '&lt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_type" string="Movement Type" context="{'group_by': 'movement_type'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'effective_datetime:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_movement_ledger_form" model="ir.ui.view">
        <field name="name">chebu.inventory.movement.ledger.form</field>
        <field name="model">chebu.inventory.movement.ledger</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="name"/><field name="effective_datetime"/><field name="movement_type"/><field name="user_id"/></group>
                        <group><field name="company_id"/><field name="branch_id"/><field name="warehouse_id"/><field name="approval_state"/></group>
                    </group>
                    <group string="Product">
                        <field name="product_id"/><field name="product_uom_id"/><field name="quantity"/><field name="quantity_signed"/><field name="lot_id"/>
                    </group>
                    <group string="Locations">
                        <field name="source_location_id"/><field name="destination_location_id"/>
                    </group>
                    <group string="Source Documents">
                        <field name="stock_move_id"/><field name="stock_move_line_id"/><field name="picking_id"/><field name="sale_order_id"/><field name="purchase_order_id"/><field name="pos_order_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_movement_ledger" model="ir.actions.act_window">
        <field name="name">Movement Ledger</field>
        <field name="res_model">chebu.inventory.movement.ledger</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_movement_ledger_search"/>
    </record>
</odoo>
