<odoo>
    <record id="view_inventory_movement_dashboard" model="ir.ui.view">
        <field name="name">chebu.inventory.movement.dashboard.form</field>
        <field name="model">chebu.inventory.movement.dashboard</field>
        <field name="arch" type="xml">
            <form string="Operations Dashboard" create="0" edit="0" delete="0">
                <header>
                    <button name="action_refresh" type="object" string="Refresh Live Data" class="btn-primary" icon="fa-refresh"/>
                    <field name="last_refreshed" widget="date"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Inventory Movement Operations</h1>
                        <div class="text-muted">Live visibility across stock, approvals, and deliveries</div>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_ledger" type="object" class="oe_stat_button" icon="fa-exchange">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_value"><field name="movement_count"/></span><span class="o_stat_text">Movements</span></div>
                        </button>
                        <button name="action_open_deliveries" type="object" class="oe_stat_button" icon="fa-truck">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_value"><field name="delivery_count"/></span><span class="o_stat_text">Delivery Plans</span></div>
                        </button>
                        <button name="action_open_approvals" type="object" class="oe_stat_button" icon="fa-check-circle">
                            <div class="o_field_widget o_stat_info"><span class="o_stat_value"><field name="pending_approval_count"/></span><span class="o_stat_text">Pending Approvals</span></div>
                        </button>
                    </div>
                    <div class="row mt16">
                        <div class="col-lg-4 col-md-6">
                            <div class="o_dashboard_item p-3 bg-success-subtle rounded">
                                <div class="text-muted">Inbound movement</div>
                                <div class="h2"><field name="inbound_count"/></div>
                                <button name="action_open_ledger" type="object" string="Open ledger" class="btn btn-link p-0"/>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="o_dashboard_item p-3 bg-warning-subtle rounded">
                                <div class="text-muted">Outbound movement</div>
                                <div class="h2"><field name="outbound_count"/></div>
                                <button name="action_open_ledger" type="object" string="Trace deliveries" class="btn btn-link p-0"/>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-6">
                            <div class="o_dashboard_item p-3 bg-info-subtle rounded">
                                <div class="text-muted">Active delivery session</div>
                                <div class="h2"><field name="active_delivery_count"/></div>
                                <button name="action_open_active_deliveries" type="object" string="Open dispatch queue" class="btn btn-link p-0"/>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16">
                        <div class="col-lg-6">
                            <div class="border rounded p-3">
                                <h3>Work queues</h3>
                                <p class="text-muted">The records that need attention now.</p>
                                <button name="action_open_active_deliveries" type="object" string="Active deliveries" class="btn btn-primary me-2" icon="fa-truck"/>
                                <button name="action_open_approvals" type="object" string="Approval queue" class="btn btn-secondary" icon="fa-check"/>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="border rounded p-3">
                                <h3>Traceability</h3>
                                <p class="text-muted">Follow every completed movement back to its source document.</p>
                                <button name="action_open_ledger" type="object" string="Open live ledger" class="btn btn-primary" icon="fa-search"/>
                            </div>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_inventory_movement_dashboard" model="ir.actions.act_window">
        <field name="name">Operations Dashboard</field>
        <field name="res_model">chebu.inventory.movement.dashboard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_inventory_movement_dashboard"/>
        <field name="target">current</field>
    </record>
</odoo>
